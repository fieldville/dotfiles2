# some more ls aliases
alias ls='ls --color'
alias ll='ls -ltrh'
alias la='ll -A'
alias l='ls'   # plain ls, same as `l` in home/.posh/PowerShell (no -CF markers)
alias df='df -h'
alias h='history'
alias dmesg='dmesg -T'
alias grep='grep -I --color --exclude-dir={.git,.svn,HTML} --exclude={\*.pyc\*}'

# aliases for git live in .galias (sourced from .bashrc right after this file)

# also load inputrc
if [[ $- =~ i ]]; then
  if [[ -n $BASH_VERSION ]]; then
    DIR=$(cd $(dirname ${BASH_SOURCE[0]}) && pwd)
    bind -f $DIR/.inputrc
  fi
fi

alias fdh="fd --no-ignore-vcs -H -E '.git/'"
alias rgh="rg -."

alias vi=nvim
alias view='nvim -R'
alias vimdiff='nvim -d'

alias lg='lazygit'
