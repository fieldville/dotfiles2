# Tools the shell rc files pick up when present. .zshrc / .bashrc load each one only if
# it is installed, so a missing one fails silently (no prompt, no suggestions, ...).
# setup.bash checks this list and offers to install what is missing; by hand:
#
#   brew bundle --file=~/.dotfiles2/Brewfile

brew "starship"                 # prompt
brew "zsh-autosuggestions"      # history suggestion as you type (Ctrl-Space accepts)
brew "zsh-syntax-highlighting"  # colours the command line
brew "fzf"                      # fuzzy finder, used by .falias
brew "zoxide"                   # `j` directory jumper
