lvim() {
  local extra_opts=()
  local target=""

  # 引数を解析して、オプション（-R, -d など）とターゲットパスを分離する
  while [ $# -gt 0 ]; do
    case "$1" in
      -*)
        extra_opts+=("$1")
        shift
        ;;
      *)
        if [ -z "$target" ]; then
          target="$1"
        else
          # 2つ目以降のファイル指定（vimdiffなどで複数ファイル指定する場合）
          extra_opts+=("$1")
        fi
        shift
        ;;
    esac
  done

  # ターゲット指定がなければカレントディレクトリ
  target="${target:-.}"

  local target_dir
  local file_name=""

  # 指定されたパスが存在するかチェック
  if [ -e "$target" ]; then
    if [ -d "$target" ]; then
      # ディレクトリが指定された場合
      target_dir="$(cd "$target" && pwd)"
    else
      # ファイルが指定された場合
      target_dir="$(cd "$(dirname "$target")" && pwd)"
      file_name="$(basename "$target")"
    fi
  else
    # 新規ファイルなど、まだ存在しないパスが渡された場合
    local parent_dir
    parent_dir="$(dirname "$target")"
    if [ -d "$parent_dir" ]; then
      target_dir="$(cd "$parent_dir" && pwd)"
      file_name="$(basename "$target")"
    else
      echo "エラー: ディレクトリ '$parent_dir' が存在しません。" >&2
      return 1
    fi
  fi

  # オプションとファイル名を組み合わせて nvim に渡す
  local nvim_args=()
  [ -n "$file_name" ] && nvim_args+=("$file_name")
  nvim_args+=("${extra_opts[@]}")

  # 親ディレクトリにマウントしてコンテナを起動
  docker run --rm -it \
    -u "$(id -u):$(id -g)" \
    --add-host host.docker.internal:host-gateway \
    -v "$target_dir:/workspace" \
    -v lazyvim-share:/home/ubuntu/.local/share/nvim \
    -v lazyvim-state:/home/ubuntu/.local/state/nvim \
    -v lazyvim-cache:/home/ubuntu/.cache/nvim \
    -v /tmp:/tmp \
    -w /workspace \
    lazyvim-sandbox nvim "${nvim_args[@]}"
}

# LazyVim Dockerイメージの再ビルド用関数
lvim-build() {
  local script_dir
  # この .alias ファイルが存在するディレクトリ（または Dockerfile のあるパス）を指定
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  echo "Building lazyvim-sandbox with UID=$(id -u) GID=$(id -g)..."

  # --no-cache オプションを渡せるようにする（例: lvim-build --no-cache）
  docker build \
    --build-arg USER_UID="$(id -u)" \
    --build-arg USER_GID="$(id -g)" \
    "$@" \
    -t lazyvim-sandbox \
    "$script_dir"
}

# クリップボードブリッジを起動
if [[ "$OSTYPE" == "darwin"* ]]; then
  pgrep -f "TCP-LISTEN:2489" >/dev/null || (socat -u TCP-LISTEN:2489,fork,reuseaddr EXEC:"pbcopy" 2>/dev/null &)
  pgrep -f "TCP-LISTEN:2490" >/dev/null || (socat TCP-LISTEN:2490,fork,reuseaddr EXEC:"pbpaste" 2>/dev/null &)
elif grep -qi -e "microsoft" -e "wsl" /proc/version 2>/dev/null; then
  pgrep -f "TCP-LISTEN:2489" >/dev/null || (socat -u TCP-LISTEN:2489,fork,reuseaddr EXEC:"/mnt/c/Windows/System32/win32yank.exe -i --crlf" 2>/dev/null &)
  pgrep -f "TCP-LISTEN:2490" >/dev/null || (socat TCP-LISTEN:2490,fork,reuseaddr EXEC:"/mnt/c/Windows/System32/win32yank.exe -o --lf" 2>/dev/null &)
fi

alias vi=lvim
alias view='lvim -R'
alias vimdiff='lvim -d'
