lvim() {
  local extra_opts=()
  local file_args=()
  local mount_opts=()
  local target_paths=()

  # 引数をオプションとファイルパスに分離
  while [ $# -gt 0 ]; do
    case "$1" in
      -*)
        extra_opts+=("$1")
        shift
        ;;
      *)
        target_paths+=("$1")
        shift
        ;;
    esac
  done

  # 引数がない場合はカレントディレクトリを開く
  if [ ${#target_paths[@]} -eq 0 ]; then
    target_paths+=(".")
  fi

  # マウント先の衝突を防ぐためのカウンター
  local mount_idx=0
  local working_dir="/workspace"

  # 各ファイルを解析して個別マウントを設定
  for path in "${target_paths[@]}"; do
    local real_path
    real_path="$(readlink -f "$path" 2>/dev/null || echo "$path")"

    local file_dir
    local file_name=""

    if [ -e "$real_path" ]; then
      if [ -d "$real_path" ]; then
        file_dir="$(cd "$real_path" && pwd)"
      else
        file_dir="$(cd "$(dirname "$real_path")" && pwd)"
        file_name="$(basename "$real_path")"
      fi
    else
      local parent_dir
      parent_dir="$(dirname "$real_path")"
      if [ -d "$parent_dir" ]; then
        file_dir="$(cd "$parent_dir" && pwd)"
        file_name="$(basename "$real_path")"
      else
        echo "エラー: ディレクトリ '$parent_dir' が存在しません。" >&2
        return 1
      fi
    fi

    if [ $mount_idx -eq 0 ]; then
      # 最初のファイルがあるディレクトリをデフォルトの作業ディレクトリ (/workspace) にマウント
      mount_opts+=("-v" "$file_dir:/workspace")
      if [ -n "$file_name" ]; then
        file_args+=("$file_name")
      else
        file_args+=(".")
      fi
      working_dir="/workspace"
    else
      # 2つ目以降で異なるディレクトリにある場合は /mnt_1, /mnt_2 ... としてマウント
      local mnt_point="/mnt_$mount_idx"
      mount_opts+=("-v" "$file_dir:$mnt_point")
      if [ -n "$file_name" ]; then
        file_args+=("$mnt_point/$file_name")
      else
        file_args+=("$mnt_point")
      fi
    fi

    ((mount_idx++))
  done

  # コンテナの起動
  docker run --rm -it \
    -u "$(id -u):$(id -g)" \
    --add-host host.docker.internal:host-gateway \
    "${mount_opts[@]}" \
    -v lazyvim-share:/home/ubuntu/.local/share/nvim \
    -v lazyvim-state:/home/ubuntu/.local/state/nvim \
    -v lazyvim-cache:/home/ubuntu/.cache/nvim \
    -v /tmp:/tmp \
    -w "$working_dir" \
    lazyvim-sandbox nvim "${extra_opts[@]}" "${file_args[@]}"
}

# LazyVim Dockerイメージの再ビルド用関数
lvim-build() {
  local script_dir
  # この .alias ファイルが存在するディレクトリ（または Dockerfile のあるパス）を指定
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  echo "Building lazyvim-sandbox with UID=$(id -u) GID=$(id -g)..."

  # --no-cache オプションを渡せるようにする（例: lvim-build --no-cache）
  docker build \
    --build-arg USER_UID="$(id -u)" \
    --build-arg USER_GID="$(id -g)" \
    "$@" \
    -t lazyvim-sandbox \
    "$script_dir"
}

# クリップボードブリッジを起動
if [[ "$OSTYPE" == "darwin"* ]]; then
  pgrep -f "TCP-LISTEN:2489" >/dev/null || (socat -u TCP-LISTEN:2489,fork,reuseaddr EXEC:"pbcopy" 2>/dev/null &)
  pgrep -f "TCP-LISTEN:2490" >/dev/null || (socat TCP-LISTEN:2490,fork,reuseaddr EXEC:"pbpaste" 2>/dev/null &)
elif grep -qi -e "microsoft" -e "wsl" /proc/version 2>/dev/null; then
  pgrep -f "TCP-LISTEN:2489" >/dev/null || (socat -u TCP-LISTEN:2489,fork,reuseaddr EXEC:"/mnt/c/Windows/System32/win32yank.exe -i --crlf" 2>/dev/null &)
  pgrep -f "TCP-LISTEN:2490" >/dev/null || (socat TCP-LISTEN:2490,fork,reuseaddr EXEC:"/mnt/c/Windows/System32/win32yank.exe -o --lf" 2>/dev/null &)
fi

alias vi=lvim
alias view='lvim -R'
alias vimdiff='lvim -d'
