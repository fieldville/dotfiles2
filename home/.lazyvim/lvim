#!/usr/bin/env bash
# LazyVim を Docker コンテナ (lazyvim-sandbox) で起動する
# シェル関数ではなく実行ファイルにしているのは $EDITOR/$VISUAL から呼べるようにするため

extra_opts=()
file_args=()
mount_opts=()
target_paths=()

# 引数をオプションとファイルパスに分離
while [ $# -gt 0 ]; do
  case "$1" in
    -*)
      extra_opts+=("$1")
      shift
      ;;
    *)
      target_paths+=("$1")
      shift
      ;;
  esac
done

# 引数がない場合はカレントディレクトリを開く
if [ ${#target_paths[@]} -eq 0 ]; then
  target_paths+=(".")
fi

# マウント先の衝突を防ぐためのカウンター
mount_idx=0
working_dir="/workspace"

# 各ファイルを解析して個別マウントを設定
for path in "${target_paths[@]}"; do
  real_path="$(readlink -f "$path" 2>/dev/null || echo "$path")"
  file_dir=""
  file_name=""

  if [ -e "$real_path" ]; then
    if [ -d "$real_path" ]; then
      file_dir="$(cd "$real_path" && pwd)"
    else
      file_dir="$(cd "$(dirname "$real_path")" && pwd)"
      file_name="$(basename "$real_path")"
    fi
  else
    parent_dir="$(dirname "$real_path")"
    if [ -d "$parent_dir" ]; then
      file_dir="$(cd "$parent_dir" && pwd)"
      file_name="$(basename "$real_path")"
    else
      echo "エラー: ディレクトリ '$parent_dir' が存在しません。" >&2
      exit 1
    fi
  fi

  if [ $mount_idx -eq 0 ]; then
    # 最初のファイルがあるディレクトリをデフォルトの作業ディレクトリ (/workspace) にマウント
    mount_opts+=("-v" "$file_dir:/workspace")
    if [ -n "$file_name" ]; then
      file_args+=("$file_name")
    else
      file_args+=(".")
    fi
    working_dir="/workspace"
  else
    # 2つ目以降で異なるディレクトリにある場合は /mnt_1, /mnt_2 ... としてマウント
    mnt_point="/mnt_$mount_idx"
    mount_opts+=("-v" "$file_dir:$mnt_point")
    if [ -n "$file_name" ]; then
      file_args+=("$mnt_point/$file_name")
    else
      file_args+=("$mnt_point")
    fi
  fi

  ((mount_idx++))
done

# コンテナの起動
exec docker run --rm -it \
  -u "$(id -u):$(id -g)" \
  --add-host host.docker.internal:host-gateway \
  "${mount_opts[@]}" \
  -v lazyvim-share:/home/ubuntu/.local/share/nvim \
  -v lazyvim-state:/home/ubuntu/.local/state/nvim \
  -v lazyvim-cache:/home/ubuntu/.cache/nvim \
  -v /tmp:/tmp \
  -w "$working_dir" \
  lazyvim-sandbox nvim "${extra_opts[@]}" "${file_args[@]}"
